# Configuration for build/RS_marching: compute a one-to-all distance field.
# The GUI and JSON API use their own inputs and do not read this file.

# Map source: random = generate a random map, image = load imagePath.
# This is separate from the GUI's One-to-all / One-to-one solver modes.
mapSource=image

########### Random map settings (mapSource=random) ###########
# Width and height in cells.
ncols=256
nrows=256
# Number of generated obstacle rectangles; overlaps and edge clipping are allowed.
nb_of_obstacles=20
# Obstacle width and height ranges in cells, before clipping at map edges.
minWidth=10
maxWidth=100
minHeight=10
maxHeight=100
# Occupied-cell value in the optional speedField.txt export only.
# This does not change path lengths or vehicle speed.
speedValue=5.0
# 1 = choose a time-based seed for each map; 0 = use seedValue.
randomSeed=1
seedValue=-365540679

########### Image map settings (mapSource=image) ###########
# Path relative to the working directory, or an absolute path.
# Keep comments on separate lines: a '#' in imagePath is part of the filename.
imagePath=images/waffle_inflated.jpeg

########### Marching settings ###########
# Exactly one start: {x,y,orientation_degrees}, in a free cell.
# x points right, y down; 0 degrees points right and 90 degrees points down.
# If changing to a random map, choose a start within its dimensions and free space.
initialFrontline={40,600,0}
# Minimum turning radius in cell units; must be positive.
radius=10

# Maximum gradient-descent iterations for same-side pivot angle optimization.
exit_it=5
# Must remain 0: the geometric marcher requires one explicitly specified start.
pose_randomness=0
# Pivot angle optimization: 1 = gradient descent, 2 = bounded interval search.
GD_bisection=1

# Print marching duration and work counts when silent=0.
timer=1

########### Output settings ###########
# 1 = write solver fields under output/; 0 = leave existing files unchanged.
# The two additional exports below also require saveResults=1.
saveResults=0
# Additional occupancy export: visibilityField.txt.
saveVisibilityField=0
# Additional compatibility export: speedField.txt; not used for planning.
saveSpeedField=0

# 1 = suppress optional messages; some diagnostics and timing still print.
silent=0
